// Fitness Trainers Platform — MongoDB Atlas via Prisma
// Set DATABASE_URL in .env.local, then: npm run db:push && npm run db:seed

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COACH
  TRAINEE
}

enum ProgramType {
  STRENGTH
  HYPERTROPHY
  CUTTING
  ENDURANCE
  CUSTOM
}

enum PhotoCategory {
  FRONT
  SIDE
  BACK
}

enum ScheduledWorkoutType {
  PERSONAL
  GROUP
}

enum AppNotificationType {
  PERSONAL_SCHEDULED
  PERSONAL_CANCELLED
  PERSONAL_UPDATED
  GROUP_SPOTS_AVAILABLE
  GROUP_CANCELLED
  GROUP_UPDATED
  GROUP_REGISTRATION
  GROUP_ENROLLED
  GROUP_UNENROLLED
  GROUP_CANCELLATION_BY_TRAINEE
  WORKOUT_REMINDER
  BODY_WEIGHT_REMINDER
}

enum ScheduledReminderType {
  ONE_HOUR_BEFORE_SPOTS
}

enum UserWorkoutReminderKind {
  THIRTY_MINUTES
  ONE_HOUR
  CUSTOM
}

enum WorkoutLogKind {
  REPORT
  SAVE
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId      String   @unique
  displayName  String?
  email        String?  @unique
  phoneNumber  String?
  age          Int?
  passwordHash String?
  role           UserRole @default(COACH)
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  traineeInvites           TraineeInvite[]           @relation("CoachInvites")
  coachedTrainees          CoachTrainee[]            @relation("CoachRelation")
  coaches               CoachTrainee[]         @relation("TraineeRelation")
  programsAsCoach       TrainingProgram[]      @relation("ProgramCoach")
  programsAsTrainee     TrainingProgram[]      @relation("ProgramTrainee")
  workoutSessions       WorkoutSession[]
  progressPhotos        ProgressPhoto[]
  questionnaireResponse    QuestionnaireResponse?
  questionnaireSubmissions QuestionnaireSubmission[]
  agreement                Agreement?
  agreementSubmissions     AgreementSubmission[]
  onboardingTemplate       CoachOnboardingTemplate?
  scheduledWorkoutsAsCoach   ScheduledWorkout[]         @relation("CoachScheduledWorkouts")
  scheduledWorkoutsAsTrainee ScheduledWorkout[]         @relation("TraineeScheduledWorkouts")
  groupWorkoutRegistrations  GroupWorkoutRegistration[]
  appNotifications           AppNotification[]
  pushSubscriptions          PushSubscription[]
  workoutReminders           UserWorkoutReminder[]
  bodyWeightLogs             BodyWeightLog[]
  bodyWeightReminder         BodyWeightReminder?
}

model TraineeInvite {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  token     String    @unique
  coachId   String    @db.ObjectId
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  coach     User      @relation("CoachInvites", fields: [coachId], references: [id])

  @@index([coachId, createdAt])
}

model CoachOnboardingTemplate {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  coachId             String   @unique @db.ObjectId
  questionnaireFields Json
  agreementText       String
  updatedAt           DateTime @updatedAt
  coach               User     @relation(fields: [coachId], references: [id])
}

model CoachTrainee {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  coachId           String    @db.ObjectId
  traineeId         String    @unique @db.ObjectId
  coachingStartDate DateTime?
  coachingEndDate   DateTime?
  workoutQuota                  Int?
  workoutsCompleted             Int?
  questionnaireRedoRequestedAt  DateTime?
  agreementRedoRequestedAt    DateTime?
  coach                         User      @relation("CoachRelation", fields: [coachId], references: [id])
  trainee           User      @relation("TraineeRelation", fields: [traineeId], references: [id])
  createdAt         DateTime  @default(now())

  @@unique([coachId, traineeId])
}

model TrainingProgram {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  coachId     String      @db.ObjectId
  traineeId   String      @db.ObjectId
  name        String
  type        ProgramType
  description String?
  isActive    Boolean     @default(true)
  coach       User        @relation("ProgramCoach", fields: [coachId], references: [id])
  trainee     User        @relation("ProgramTrainee", fields: [traineeId], references: [id])
  exercises   ProgramExercise[]
  sessions    WorkoutSession[]
  scheduledWorkouts ScheduledWorkout[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProgramExercise {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  programId    String          @db.ObjectId
  name         String
  sets         Int
  reps         Int
  restSeconds  Int             @default(60)
  coachNotes   String?
  youtubeUrl   String?
  videoUrl     String?
  instructions String?
  sortOrder    Int             @default(0)
  program      TrainingProgram @relation(fields: [programId], references: [id])
  logs         ExerciseLog[]
}

model WorkoutSession {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  programId     String           @db.ObjectId
  traineeId     String           @db.ObjectId
  notes         String?
  completedAt   DateTime         @default(now())
  loggedByRole  UserRole?
  logKind       WorkoutLogKind?
  program       TrainingProgram  @relation(fields: [programId], references: [id])
  trainee       User             @relation(fields: [traineeId], references: [id])
  logs          ExerciseLog[]
}

model ExerciseLog {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  sessionId     String          @db.ObjectId
  exerciseId    String          @db.ObjectId
  weightKg      Float?
  repsCompleted Int?
  notes         String?
  session       WorkoutSession  @relation(fields: [sessionId], references: [id])
  exercise      ProgramExercise @relation(fields: [exerciseId], references: [id])
  setLogs       ExerciseSetLog[]
}

model ExerciseSetLog {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  exerciseLogId String      @db.ObjectId
  setNumber     Int
  weightKg      Float?
  repsCompleted Int?
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id])

  @@unique([exerciseLogId, setNumber])
}

model ProgressPhoto {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  traineeId  String        @db.ObjectId
  category   PhotoCategory
  imageUrl   String
  weekStart  DateTime
  uploadedAt DateTime      @default(now())
  trainee    User          @relation(fields: [traineeId], references: [id])

  @@index([traineeId, weekStart])
}

model QuestionnaireResponse {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  traineeId       String   @unique @db.ObjectId
  answers         Json?
  age             Int?
  heightCm        Float?
  weightKg        Float?
  goal            String?
  experience      String?
  injuries        String?
  sessionsPerWeek Int?
  equipment       String?
  completedAt     DateTime @default(now())
  trainee         User     @relation(fields: [traineeId], references: [id])
}

model Agreement {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  traineeId             String   @unique @db.ObjectId
  agreedAt              DateTime @default(now())
  ipAddress             String?
  signatureUrl          String
  agreementTextSnapshot String?
  contentVersion        String   @default("1.0")
  trainee               User     @relation(fields: [traineeId], references: [id])
}

model QuestionnaireSubmission {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  traineeId       String   @db.ObjectId
  answers         Json?
  age             Int?
  heightCm        Float?
  weightKg        Float?
  goal            String?
  experience      String?
  injuries        String?
  sessionsPerWeek Int?
  equipment       String?
  completedAt     DateTime
  archivedAt      DateTime @default(now())
  trainee         User     @relation(fields: [traineeId], references: [id])

  @@index([traineeId, completedAt])
}

model AgreementSubmission {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  traineeId             String   @db.ObjectId
  agreedAt              DateTime
  ipAddress             String?
  signatureUrl          String
  agreementTextSnapshot String?
  contentVersion        String   @default("1.0")
  archivedAt            DateTime @default(now())
  trainee               User     @relation(fields: [traineeId], references: [id])

  @@index([traineeId, agreedAt])
}

model ScheduledWorkout {
  id              String               @id @default(auto()) @map("_id") @db.ObjectId
  coachId         String               @db.ObjectId
  type            ScheduledWorkoutType
  workoutKind     ProgramType
  startsAt        DateTime
  durationMinutes Int
  traineeId       String?              @db.ObjectId
  programId       String?              @db.ObjectId
  maxParticipants Int?
  notes           String?
  cancelledAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  coach           User                 @relation("CoachScheduledWorkouts", fields: [coachId], references: [id])
  trainee         User?                @relation("TraineeScheduledWorkouts", fields: [traineeId], references: [id])
  program         TrainingProgram?     @relation(fields: [programId], references: [id])
  registrations   GroupWorkoutRegistration[]
  reminderJobs    ScheduledReminderJob[]
  userReminders   UserWorkoutReminder[]

  @@index([coachId, startsAt])
  @@index([traineeId, startsAt])
  @@index([startsAt, cancelledAt])
}

model GroupWorkoutRegistration {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  workoutId    String           @db.ObjectId
  traineeId    String           @db.ObjectId
  registeredAt DateTime         @default(now())
  cancelledAt  DateTime?
  workout      ScheduledWorkout @relation(fields: [workoutId], references: [id])
  trainee      User             @relation(fields: [traineeId], references: [id])

  @@unique([workoutId, traineeId])
  @@index([traineeId, cancelledAt])
}

model AppNotification {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  userId    String              @db.ObjectId
  type      AppNotificationType
  title     String
  body      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@index([userId])
}

model ScheduledReminderJob {
  id           String                @id @default(auto()) @map("_id") @db.ObjectId
  workoutId    String                @db.ObjectId
  reminderType ScheduledReminderType
  scheduledFor DateTime
  sentAt       DateTime?
  workout      ScheduledWorkout      @relation(fields: [workoutId], references: [id])

  @@unique([workoutId, reminderType])
}

model UserWorkoutReminder {
  id           String                  @id @default(auto()) @map("_id") @db.ObjectId
  workoutId    String                  @db.ObjectId
  userId       String                  @db.ObjectId
  kind         UserWorkoutReminderKind
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  workout      ScheduledWorkout        @relation(fields: [workoutId], references: [id])
  user         User                    @relation(fields: [userId], references: [id])

  @@unique([workoutId, userId])
  @@index([scheduledFor, sentAt])
  @@index([userId])
}

model BodyWeightLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  traineeId   String   @db.ObjectId
  weightKg    Float
  recordedAt  DateTime
  recordedDay String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trainee     User     @relation(fields: [traineeId], references: [id])

  @@unique([traineeId, recordedDay])
  @@index([traineeId, recordedAt])
}

model BodyWeightReminder {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  traineeId  String    @unique @db.ObjectId
  enabled    Boolean   @default(true)
  daysOfWeek Int[]
  timeLocal  String
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  trainee    User      @relation(fields: [traineeId], references: [id])
}
